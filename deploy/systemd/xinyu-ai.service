[Unit]
Description=Xinyu internal Python service
Wants=network-online.target
After=network-online.target xinyu-backend.service

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<PYTHON_RELEASE_DIR>
EnvironmentFile=<PYTHON_ENV_FILE>
ExecStart=<PYTHON_RELEASE_DIR>/.venv/bin/python -m uvicorn app.main:app_from_env --factory --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xinyu-ai

[Install]
WantedBy=multi-user.target
