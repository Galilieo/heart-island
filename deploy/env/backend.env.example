# systemd EnvironmentFile 模板；替换占位符后仅保存在服务器受限文件中，禁止提交实际值。
DB_URL="jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&useSSL=<DB_TLS_ENABLED>&allowPublicKeyRetrieval=<DB_PUBLIC_KEY_RETRIEVAL>"
DB_USERNAME="<DB_USER>"
DB_PASSWORD="<DB_PASSWORD>"
# 必需：至少 32 个 UTF-8 字节；服务器上 openssl rand -base64 48 生成，所有用户需重新登录。
JWT_SECRET="<JWT_SECRET>"
# 小内存单机、多站共用时的初始堆预算示例；按现场余量调整，真实稳定性留待上线观察。
JAVA_TOOL_OPTIONS="-Xms128m -Xmx384m"
SERVER_ADDRESS="127.0.0.1"
SERVER_PORT="8080"
AI_WORKER_ENABLED="false"
# 所有 Java 实例都需要内部地址和令牌；社区同步生成与 worker 开关独立。
AI_SERVICE_BASE_URL="http://127.0.0.1:8000"
AI_INTERNAL_TOKEN="<AI_INTERNAL_TOKEN>"
AI_WORKER_CONCURRENCY="3"
AI_COMMUNITY_CONCURRENCY="3"
AI_DNS_FAILURE_CACHE_SECONDS="10"
# 密码须先做 URI 百分号编码；只连接本机 Redis，不将该 URL 输出到日志或报告。
REDIS_URL="redis://:<URI_ENCODED_REDIS_PASSWORD>@127.0.0.1:6379/0"
# Spring 环境变量名按官方宽松绑定规则移除连字符、用下划线分隔层级。
# xinyu.review.time-zone
XINYU_REVIEW_TIMEZONE="Asia/Shanghai"
# xinyu.rate-limit.enabled / key-prefix / redis-timeout / fallback-cooldown
XINYU_RATELIMIT_ENABLED="true"
XINYU_RATELIMIT_KEYPREFIX="xinyu:prod:"
XINYU_RATELIMIT_REDISTIMEOUT="200ms"
XINYU_RATELIMIT_FALLBACKCOOLDOWN="30s"
# xinyu.rate-limit.mood-per-hour / mood-per-day / community-per-hour / review-per-day / global-per-hour
XINYU_RATELIMIT_MOODPERHOUR="20"
XINYU_RATELIMIT_MOODPERDAY="100"
XINYU_RATELIMIT_COMMUNITYPERHOUR="10"
XINYU_RATELIMIT_REVIEWPERDAY="10"
XINYU_RATELIMIT_GLOBALPERHOUR="1000"
