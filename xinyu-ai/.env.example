# 请将以下变量注入服务进程环境；应用不会自动加载本文件。
# 必需配置留空时将阻止启动；真实密钥不得提交到仓库。
AI_INTERNAL_TOKEN=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
# 当前官方别名 deepseek-flash 对应 V4.1-Flash-1017，不代表永久锁定该版本。
OPENAI_MODEL=deepseek-flash
# 显式适配供应商参数：发送 {"thinking": {"type": "disabled"}}。
DEEPSEEK_THINKING_MODE=disabled
# 输出 token 预算（含思考开销）：默认 4096，本服务允许 1～8192；不是回复字数。
# 开启 thinking 时应同时检查预算；调大仍不保证在 40 秒内完成。
OPENAI_MAX_TOKENS=4096

# 单进程生成门禁，默认与Java执行槽位同为3。
AI_SERVICE_CONCURRENCY=3
