# systemd EnvironmentFile；与 Java 使用同一个内部令牌，实际内容只保存在服务器。
AI_INTERNAL_TOKEN="<AI_INTERNAL_TOKEN>"
OPENAI_BASE_URL="<OPENAI_COMPATIBLE_BASE_URL>"
OPENAI_API_KEY="<OPENAI_API_KEY>"
OPENAI_MODEL="<OPENAI_MODEL>"
DEEPSEEK_THINKING_MODE="disabled"
OPENAI_MAX_TOKENS="4096"
AI_SERVICE_CONCURRENCY="3"
AI_COMMUNITY_CONCURRENCY="3"
# Python 不自动加载 .env；由 systemd 注入。40 秒处理上限不是可从环境覆盖的参数。
PYTHONUNBUFFERED="1"
